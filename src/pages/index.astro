    detail: "Maderoterapija i anticelulitni rituali",
    width: 360,
    height: 480,
  },
  {
    src: "/cupping.jpeg",
    alt: "Cupping tretman leđa tijekom usluge u Aura Beauty Studiju",
    title: "Masaže",
    detail: "Cupping i opuštanje mišića",
    width: 360,
    height: 480,
  },
  {
    src: "/spa-day.jpeg",
    alt: "Klijentica na tretmanu lica s maskom u Aura Beauty Studiju",
