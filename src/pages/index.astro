const galleryPhotos = [
  {
    src: "/studio/IMG_6966.jpg",
    alt: "Pogled prema ulazu i radnim mjestima u salonu",
    width: 1600,
    height: 1200,
  },
  {
    src: "/studio/IMG_6971.jpg",
