<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aura Beauty Studio Zagreb — Masaže, Skincare, Head Spa, Nokti i tretmani tijela. Vukomerec 36, Zagreb." />
    <title>Aura Beauty Studio | Zagreb</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>

    <!-- NAV -->
    <nav class="nav" id="nav">
      <a href="#hero" class="nav-logo">AURA</a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#o-nama">O Nama</a></li>
        <li><a href="#usluge">Usluge</a></li>
        <li><a href="#galerija">Galerija</a></li>
        <li><a href="#cjenik">Cjenik</a></li>
        <li><a href="#kontakt" class="nav-cta">Rezerviraj</a></li>
      </ul>
    </nav>

    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-bg">
        <img
          class="hero-image"
          src={heroImage.src}
          alt={heroImage.alt}
          width={heroImage.width}
          height={heroImage.height}
          sizes="100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="hero-image-overlay"></div>
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
        <div class="noise"></div>
      </div>
      <div class="hero-content">
        <p class="hero-eyebrow">Beauty Studio · Zagreb</p>
        <h1 class="hero-title">
          <span class="hero-title-line">Gdje</span>
          <span class="hero-title-line hero-title-italic">ljepota</span>
          <span class="hero-title-line">postaje ritual</span>
        </h1>
        <p class="hero-sub">Personalizirani tretmani za tijelo i dušu u srcu Zagreba</p>
        <div class="hero-actions">
          <a href="#cjenik" class="btn btn-primary">Pogledaj cjenik</a>
          <a href="tel:+385953679016" class="btn btn-ghost">+385 95 367 9016</a>
        </div>
      </div>
      <div class="hero-scroll-indicator">
        <span>Skrolaj</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- O NAMA -->
    <section class="about" id="o-nama">
      <div class="container">
        <div class="about-grid">
          <div class="about-text">
            <p class="section-label">O Nama</p>
            <h2 class="section-title">Autentično.<br/>Senzorično.<br/>Tvoje.</h2>
            <p class="about-body">
              Aura Beauty Studio je prostor stvoren za žene koje cijene kvalitetu, mir i rezultate.
              Svaki tretman osmišljavan je s pažnjom prema detalju — jer vjerujemo da prava ljepota
              dolazi iz iznutra, a naš posao je da je iznesemo na površinu.
            </p>
            <p class="about-body">
              Smješteni u Vukomercu, Zagreb, nudimo personalizirani pristup svakoj klijentici.
              Naši tretmani spajaju najnovije tehnike s holističkim pristupom wellnessu.
            </p>
            <a href="#kontakt" class="btn btn-outline">Upoznaj nas →</a>
          </div>
          <div class="about-photos">
            <div class="photo-grid">
              <div class="photo-slot photo-main">
                <img
                  class="photo-image"
                  src={aboutPhotos[0].src}
                  alt={aboutPhotos[0].alt}
                  width={aboutPhotos[0].width}
                  height={aboutPhotos[0].height}
                  sizes="(max-width: 768px) 100vw, 40vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="photo-slot photo-sm-1">
                <img
                  class="photo-image"
                  src={aboutPhotos[1].src}
                  alt={aboutPhotos[1].alt}
                  width={aboutPhotos[1].width}
                  height={aboutPhotos[1].height}
                  sizes="(max-width: 768px) 50vw, 20vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="photo-slot photo-sm-2">
                <img
                  class="photo-image"
                  src={aboutPhotos[2].src}
                  alt={aboutPhotos[2].alt}
                  width={aboutPhotos[2].width}
                  height={aboutPhotos[2].height}
                  sizes="(max-width: 768px) 50vw, 20vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- USLUGE -->
    <section class="services" id="usluge">
      <div class="container">
        <div class="section-header center">
          <p class="section-label">Usluge</p>
          <h2 class="section-title">Ritual za svaku<br/><em>verziju tebe</em></h2>
        </div>
        <div class="services-grid">
          {services.map((s) => (
            <div class="service-card">
              <div class="service-icon">{s.icon}</div>
              <h3 class="service-name">{s.name}</h3>
              <p class="service-desc">{s.desc}</p>
              <a href="#cjenik" class="service-link">Pogledaj cijene →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GALERIJA - Photo placeholders -->
    <section class="gallery" id="galerija">
      <div class="container">
        <div class="section-header center">
          <p class="section-label">Galerija</p>
          <h2 class="section-title">Atmosfera<br/><em>studija</em></h2>
        </div>
      </div>
      <div class="gallery-scroll">
        <div class="gallery-track">
          {galleryPhotos.map((photo) => (
            <figure class="gallery-item">
              <img
                class="gallery-image"
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                sizes="(max-width: 768px) 80vw, 28vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- INSTAGRAM REELS -->
    <section class="reels" id="reels">
      <div class="container">
        <div class="reels-header">
          <div>
            <p class="section-label">Instagram</p>
            <h2 class="section-title">Prati naš<br/><em>svijet</em></h2>
          </div>
          <a
            href="https://www.instagram.com/aurabeautystudiio/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            @aurabeautystudiio
          </a>
        </div>
      </div>
      <div class="reels-scroll">
        <div class="reels-track">
          {reels.map((r) => (
            <a
              href="https://www.instagram.com/aurabeautystudiio/"
              target="_blank"
              rel="noopener noreferrer"
              class="reel-card"
            >
              <div class="reel-thumb">
                <img
                  class="reel-image"
                  src={r.image}
                  alt={r.alt}
                  width="1600"
                  height="1200"
                  sizes="(max-width: 768px) 55vw, 180px"
                  loading="lazy"
                  decoding="async"
                />
                <div class="reel-play-badge" aria-hidden="true">
                  <svg class="reel-play" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              <div class="reel-info">
                <span class="reel-label">{r.label}</span>
                <svg class="reel-ig" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CJENIK -->
    <section class="pricing" id="cjenik">
      <div class="container">
        <div class="section-header center">
          <p class="section-label">Cjenik</p>
          <h2 class="section-title">Transparentne<br/><em>cijene</em></h2>
          <p class="pricing-note">Sve cijene su u eurima (€). Za pakete i posebne ponude kontaktirajte nas.</p>
        </div>
        <div class="pricing-grid">
          {priceCategories.map((cat) => (
            <div class="pricing-card">
              <h3 class="pricing-cat">{cat.name}</h3>
              <ul class="pricing-list">
                {cat.items.map((item) => (
                  <li class="pricing-row">
                    <span class="pricing-item-name">{item.name}</span>
                    <span class="pricing-item-price">{item.price}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- KONTAKT -->
    <section class="contact" id="kontakt">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-text">
            <p class="section-label">Kontakt</p>
            <h2 class="section-title">Rezerviraj<br/><em>svoj tretman</em></h2>
            <p class="contact-sub">Uvijek smo tu za tebe. Javi nam se i zajednički ćemo pronaći idealan tretman za tebe.</p>
            <div class="contact-info">
              <a href="tel:+385953679016" class="contact-item">
                <div class="contact-icon">◎</div>
                <div>
                  <p class="contact-label">Telefon</p>
                  <p class="contact-value">+385 95 367 9016</p>
                </div>
              </a>
              <a href="https://maps.google.com/?q=Vukomerec+36+Zagreb" target="_blank" rel="noopener" class="contact-item">
                <div class="contact-icon">◈</div>
                <div>
                  <p class="contact-label">Adresa</p>
                  <p class="contact-value">Vukomerec 36, Zagreb</p>
                </div>
              </a>
              <a href="https://www.instagram.com/aurabeautystudiio/" target="_blank" rel="noopener" class="contact-item">
                <div class="contact-icon">✦</div>
                <div>
                  <p class="contact-label">Instagram</p>
                  <p class="contact-value">@aurabeautystudiio</p>
                </div>
              </a>
            </div>
          </div>
          <div class="contact-map">
            <div class="map-placeholder">
              <div class="map-inner">
                <span class="map-pin">◈</span>
                <p class="map-address">Vukomerec 36</p>
                <p class="map-city">Zagreb, Hrvatska</p>
                <a href="https://maps.google.com/?q=Vukomerec+36+Zagreb" target="_blank" rel="noopener" class="btn btn-primary">Otvori u Google Maps</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container">
        <div class="footer-inner">
          <p class="footer-logo">AURA</p>
          <p class="footer-copy">© 2025 Aura Beauty Studio · Vukomerec 36, Zagreb</p>
          <a href="https://www.instagram.com/aurabeautystudiio/" target="_blank" rel="noopener" class="footer-ig">Instagram</a>
        </div>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  /* ── RESET & BASE ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #CBB283;
    --gold-dark: #B89A68;
    --gold-light: #E2D0B0;
    --cream: #FAF9F5;
    --cream-warm: #F4EFE6;
    --dark: #1A1814;
    --dark-2: #2C2A26;
    --dark-3: #424754;
    --text: #222;
    --text-muted: #8B856F;

