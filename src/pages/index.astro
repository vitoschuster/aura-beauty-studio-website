const treatmentProof = [
  {
    src: "/nails3.jpeg",
    alt: "Nježna ružičasta manikura nakon tretmana noktiju u Aura Beauty Studiju",
    title: "Nokti & stopala",
    detail: "Prirodni finiš i uredna forma",
    width: 360,
    height: 640,
  },
  {
    src: "/nails1.jpeg",
    alt: "Tirkizna manikura i pedikura nakon tretmana u Aura Beauty Studiju",
    title: "Manikura & pedikura",
    detail: "Boja, urednost i završni sjaj",
    width: 360,
    height: 640,
  },
  {
    src: "/nails5.jpeg",
    alt: "Tamnocrvena manikura s ukrasnim detaljima nakon tretmana",
    title: "Trajni lak",
    detail: "Sezonski dizajni i sjajni završetak",
    width: 360,
    height: 640,
  },
  {
    src: "/face-red-mask.jpeg",
    alt: "Klijentica tijekom LED mask tretmana lica u salonu",
    title: "Skincare",
    detail: "LED maska i oporavak kože",
    width: 360,
