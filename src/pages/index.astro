---
import pricing from '../data/pricing.json';
import priceLists from '../data/price-lists.json';

const services = [
  {
    icon: "✦",
    name: "Masaže",
    desc: "Relax, anticelulitna, čokoladna i medicinska masaža tijela i lica"
  },
  {
    icon: "◈",
    name: "Skincare",
    desc: "Tretmani lica, Pure Gold, derma pen, RF lifting i kisikove terapije"
  },
  {
    icon: "❋",
    name: "Head Spa",
    desc: "Luksuzna njega vlasišta i opuštajući rituali za kosu i glavu"
  },
  {
    icon: "◇",
    name: "Nokti & Stopala",
    desc: "Manikura, pedikura, trajni lak, parafinska kupka i njega noktiju"
  },
  {
    icon: "◉",
    name: "Ljepota Očiju",
    desc: "Lash lift, oblikovanje obrva, bojanje i korekcija pogleda"
  },
  {
    icon: "⬡",
    name: "Body Sculpting",
    desc: "Maderoterapija, Vakuum Fit i anticelulitni programi za tijelo"
  },
];

type PriceService = {
  name: string;
  displayName?: string;
  price: string;
  anchorPrice: string;
  group?: { name: string; details: string[]; renderHeading?: boolean };
};
type PriceCategory = { id: string; label: string; services: PriceService[] };
const priceCategories: PriceCategory[] = pricing.categories;
const latestPriceList = priceLists.lists[0];

const heroImage = {
  src: "/studio/IMG_6978.jpg",
  alt: "Interijer Aura Beauty Studija s beauty stolicama i ogledalima",
  width: 1600,
  height: 1200,
};

const aboutPhotos = [
  {
    src: "/studio/IMG_6968.jpg",
    alt: "Središnji dio salona s akvarijem i prirodnim svjetlom",
